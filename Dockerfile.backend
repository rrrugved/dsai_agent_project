FROM python:3.11-slim

WORKDIR /app

# Install system dependencies (OCR, Audio, and Tini for process management)
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ffmpeg tesseract-ocr tini \
    && rm -rf /var/lib/apt/lists/*

# Add uv's virtual environment to PATH
ENV PATH="/app/.venv/bin:$PATH"

# Install uv
RUN pip install --no-cache-dir uv

# Cache the dependencies layer
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# Copy the rest of the application
COPY . ./
RUN uv sync --frozen --no-dev

EXPOSE 10000

# Use Tini to manage the FastAPI process cleanly
ENTRYPOINT ["tini", "--"]
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "10000"]